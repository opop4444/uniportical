# Copy to .env — these values are passed straight into the container (env_file).
#
# Required:
UNIFI_HOST=192.168.1.1
# Local UniFi API key: UniFi Network -> Settings -> Control Plane -> Integrations
#   -> Create API Key (type: UniFi Applications / Network)
UNIFI_API_KEY=your-unifi-api-key
UNIPORTICAL_POLL_INTERVAL=30
#
# Optional — only needed when NOT using network_mode: host:
# UNIPORTICAL_HOST_IP=192.168.1.50
